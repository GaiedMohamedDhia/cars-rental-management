DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cars-rental
# Required: generate a unique value with at least 32 random characters.
# Example command: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Browser requests always use the same-origin /api proxy.
# In Docker/Kubernetes this must be the internal backend service URL.
INTERNAL_API_BASE_URL=http://backend:8000
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cars-rental
NEXT_PUBLIC_COMPANY_NAME=TuniCars+
NEXT_PUBLIC_COMPANY_ADDRESS=
NEXT_PUBLIC_COMPANY_PHONE=
NEXT_PUBLIC_COMPANY_EMAIL=
NEXT_PUBLIC_COMPANY_WEBSITE=
NEXT_PUBLIC_COMPANY_TERMS=
